; Seek Nano (PIR324) raw WinUSB binding - child interfaces only
; vid 289D pid 0011 - composite vendor-class device
; install with:  pnputil /add-driver seeknano.inf /install
;                pnputil /scan-devices
;
; ---------------------------------------------------------------------------
; The parent node  USB\VID_289D&PID_0011  is deliberately NOT bound here.
; It is owned by the USBIP / VirtualBox stack (bindinfo.txt shows
; "USBIP Shared Device ... svc=VBoxUSB"). Claiming it for WinUSB fights that
; filter driver for the whole device and is what left both MI_* children
; Present=False after the 2026-09-29 bind run.
;
; bind.ps1 writes Service/Class/ClassGUID/DeviceInterfaceGUIDs straight into
; the MI_* Enum keys and cycles just those two nodes; that is what sncap.exe
; actually relies on.  This INF now matches that proven layout so the two
; routes agree instead of fighting.
;
; Observed interface behaviour (out\sncap.err, 2026-09-28 22:33):
;   MI_00  iAP Interface        alt 0  bulk IN 0x81  3/3 frames, 47-234 ms
;                                 head 79 05 ... <- the real stream
;   MI_01  com.thermal.pir324.3  alt 1  bulk IN 0x82  0/3 frames, all 00,
;                                 [bulk] FAILED want=177840 winerr=121
; ---------------------------------------------------------------------------
[Version]
Signature   = "$Windows NT$"
Class       = USB
ClassGuid   = {36fc9e60-c465-11cf-8056-444553540000}
Provider    = %ProviderName%
DriverVer   = 09/28/2026,1.0.0.0

[Manufacturer]
%ProviderName% = Standard, NTamd64, NTarm64

[Standard.NTamd64]
%MI00Name% = WINUSB_Install, USB\VID_289D&PID_0011&MI_00
%MI01Name% = WINUSB_Install, USB\VID_289D&PID_0011&MI_01

[Standard.NTarm64]
%MI00Name% = WINUSB_Install, USB\VID_289D&PID_0011&MI_00
%MI01Name% = WINUSB_Install, USB\VID_289D&PID_0011&MI_01

[Standard.NTamd64.HW]
AddReg = MI00Guid, MI01Guid

[Standard.NTarm64.HW]
AddReg = MI00Guid, MI01Guid

[Standard.NTamd64.Services]
WINUSB_Install = WINUSB_Install.Services

[Standard.NTarm64.Services]
WINUSB_Install = WINUSB_Install.Services

[WINUSB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[WINUSB_Install.Services]
AddService = winusb, 0x00000002, winusb_ServiceInstall

[winusb_ServiceInstall]
DisplayName   = %WinUsbService%
ServiceType   = 1  ; SERVICE_KERNEL_DRIVER
StartType     = 3  ; demand start
ErrorControl  = 1
ServiceBinary = %12%\winusb.sys

[WINUSB_Install.HW]
AddReg = PowerMgmt

; keep the device awake while capture apps run (laptops stall bulk streams)
[PowerMgmt]
HKR,,"SSEnable"        ,0x00010001,0
HKR,,"SelectiveSuspendOn",0x00010001,0
HKR,,"IdleInWorkingState",0x00010001,0

; MI_00 = iAP Interface - the interface that actually streams (bulk IN 0x81)
[MI00Guid]
HKR,,DeviceInterfaceGUIDs,0x10000,"{1C2BD42A-95E0-4D26-9A79-E1F2C86AC389}"

; MI_01 = com.thermal.pir324.3 - enumerates, but returns only zeros
[MI01Guid]
HKR,,DeviceInterfaceGUIDs,0x10000,"{1BA6F5C0-2A6D-4B02-9F73-4E4408D4F7D0}"

[Strings]
ProviderName   = "SeekNano Open Project"
MI00Name       = "Seek Nano iAP Interface (WinUSB)"
MI01Name       = "Seek Nano pir324.3 Interface (WinUSB)"
WinUsbService  = "WinUSB"
