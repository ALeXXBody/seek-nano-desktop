# --- viewer build and runtime output ---
# PyInstaller writes these; the canonical build recipe is
# .github/workflows/build.yml, not a generated spec.
dist/
SeekNano.spec

# Third-party or locally-built binaries. libusb-1.0.dll is LGPL and belongs in
# the release zip, not in git; the two seeknano*.dll are built from
# src/transport and are outputs, not sources.
*.dll

# Written by the running viewer at ~frame rate. Diagnostic, not source.
burst_*.png
latest.png
seeknano_crash.log
seeknano_verbose.log
nuc_out/
.pytest_cache/
*.png
*.snrec

# Written by the scanline watchdog when it rejects a mid-frame-gain-change
# frame, and by the hardware suites' reference captures. Test output, and the
# watchdog dumps are large - one is 485 KB per fault.
scanline_fault_*.raw
out/
dump/

# probe output: blobs pulled off the camera, device-specific
app/res/
